# Optional — WalletConnect Cloud project ID (injected/MetaMask works without it)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional overrides
NEXT_PUBLIC_BLOCKPASS_ADDRESS=0xbdb5f9745db186c25424fa0ec5b81009980b87c2
NEXT_PUBLIC_BASE_SEPOLIA_RPC=https://sepolia.base.org
NEXT_PUBLIC_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# Leave empty to use Next.js /api (file store). Set to proxy Express backend.
# NEXT_PUBLIC_API_URL=http://localhost:3002
# BACKEND_URL=http://localhost:3002

# Express backend (server/.env)
# PORT=3002
# MONGODB_URI=mongodb://localhost:27017/blockpass-ticketing
# FRONTEND_URL=http://localhost:3000
# ADMIN_WALLET=0xYourAdminWallet
